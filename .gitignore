# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# secrets — never commit
GoogleService-Info.plist
google-services.json

# Supabase local runtime
supabase/.branches/
supabase/.temp/
supabase/.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Vercel
.vercel/
.vercel
.env*

