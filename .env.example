# ─── Supabase ────────────────────────────────────────────────────────────────
# Local dev: run `npx supabase start` and copy the printed "API URL" and "anon key".
# Hosted: Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── PostHog analytics (optional in dev; disabled in __DEV__ anyway) ─────────
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Google sign-in (optional; native dev build required) ────────────────────
# Google Cloud Console → Credentials → Web application OAuth client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# NOTE: only EXPO_PUBLIC_* vars reach the app. The Supabase service-role key,
# Resend API key and moderation provider keys live ONLY in Edge Function
# secrets (`supabase secrets set ...`), never here.
